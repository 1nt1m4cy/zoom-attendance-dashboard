# Attendance Companion - Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to version control.

ZOOM_EMAIL=your_zoom_email@example.com
ZOOM_PASSWORD=your_zoom_password
BOT_NAME=Attendance Bot

# Optional: Email attendance after export
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords)
SMTP_EMAIL=your_sender_email@gmail.com
SMTP_PASSWORD=your_app_password
